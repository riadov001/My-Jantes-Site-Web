# ============================================================
# MyJantes - Variables d'environnement (PRODUCTION)
# ============================================================
# Copiez ce fichier vers .env puis renseignez chaque valeur.
# NE COMMITTEZ JAMAIS .env dans Git.
# ============================================================

# --- OBLIGATOIRE ---

# URL de connexion PostgreSQL
# Format : postgresql://utilisateur:motdepasse@hote:5432/nom_base
# Hostinger ne fournit pas de Postgres en hébergement mutualisé.
# Utilisez Neon (gratuit) : https://neon.tech
# Ou Supabase : https://supabase.com
DATABASE_URL=postgresql://user:password@host:5432/myjantes

# Clé secrète pour signer les sessions (chaîne aléatoire de 32+ caractères)
# Générer une clé : openssl rand -hex 32
SESSION_SECRET=changez_cette_cle_par_une_chaine_aleatoire_de_64_caracteres_min

# Port d'écoute du serveur (Hostinger Node.js l'injecte automatiquement)
PORT=3000

# Environnement (toujours "production" en ligne)
NODE_ENV=production

# URL publique du site (pour CORS, e-mails, OG tags)
SITE_URL=https://myjantes.fr


# --- E-MAILS (Resend) ---
# Inscrivez-vous sur https://resend.com pour obtenir une clé API
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx


# --- IA (optionnel - utilisé pour OCR carte grise) ---
# Si vous n'utilisez pas l'OCR, vous pouvez laisser vides
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_GEMINI_API_KEY=
AI_INTEGRATIONS_GEMINI_BASE_URL=https://generativelanguage.googleapis.com


# --- OBJECT STORAGE (optionnel - pour upload d'images depuis l'admin) ---
# Si vous n'utilisez pas l'upload d'images, vous pouvez laisser vides.
# Ces variables sont spécifiques à Replit Object Storage (Google Cloud Storage).
# Pour Hostinger, vous pouvez :
#   - héberger les images directement dans /public/media (recommandé)
#   - ou utiliser un bucket S3/Cloudflare R2 (nécessite adaptation du code)
PUBLIC_OBJECT_SEARCH_PATHS=
PRIVATE_OBJECT_DIR=
